{
  "uid": "local-qwen",
  "title": "Local LLM — Qwen & GPU",
  "schemaVersion": 39,
  "version": 5,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "llama.cpp",
    "qwen",
    "gpu"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Доступность моделей",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "description": "0: профиль остановлен либо endpoint недоступен. При переключении моделей один остановленный профиль ожидаем.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "остановлена",
                  "color": "gray"
                },
                "1": {
                  "text": "работает",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"${model:regex}\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 18
        }
      }
    },
