    {
      "id": 21,
      "title": "MTP: доля принятых черновых токенов",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "description": "Сколько токенов, предложенных MTP-головой (speculative decoding), подтвердила основная модель. Выше доля — выше ускорение. Нет данных: модель без MTP или не было генерации.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(rate(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"${model:regex}\"}[$__rate_interval])) / sum by(job)(rate(llamacpp:spec_decode_num_draft_tokens_total{job=~\"${model:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
