    {
      "id": 4,
      "title": "Входные токены за выбранный период",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 4
      },
      "description": "Оценка Prometheus по счётчику llama.cpp. Короткие запуски между scrape могут быть пропущены. «Из кеша» — токены, взятые из prompt cache / checkpoints без повторной обработки.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(increase(llamacpp:prompt_tokens_total{job=~\"${model:regex}\"}[$__range]))",
          "legendFormat": "{{job}} · всего",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by(job)(increase(llamacpp:prompt_tokens_cached_total{job=~\"${model:regex}\"}[$__range]))",
          "legendFormat": "{{job}} · из кеша",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
