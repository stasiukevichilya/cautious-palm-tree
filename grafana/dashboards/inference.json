          "refId": "A",
          "expr": "sum by(job)(increase(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"${model:regex}\"}[$__range])) / sum by(job)(increase(llamacpp:spec_decode_num_draft_tokens_total{job=~\"${model:regex}\"}[$__range]))",
          "legendFormat": "{{job}} · принято",
