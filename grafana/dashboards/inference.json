{
  "uid": "local-qwen",
  "title": "Local LLM — Qwen, Gemma & GPU",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "llama.cpp",
    "gemma",
    "qwen",
    "gpu"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Доступность моделей",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "0: профиль остановлен либо endpoint недоступен. При переключении моделей один остановленный профиль ожидаем.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Остановлена / недоступна",
                  "color": "gray"
                },
                "1": {
                  "text": "Доступна",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"${model:regex}\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
