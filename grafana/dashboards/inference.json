    {
      "id": 24,
      "title": "MTP: принятие по позиции черновика за период",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      },
      "description": "Доля черновиков, в которых основная модель подтвердила токен на этой позиции (0 — первый черновой токен). Число позиций = --spec-draft-n-max. Если доля последней позиции заметно ниже ~0.5, лишняя позиция почти не даёт ускорения и только тратит вычисления; если высокая — можно попробовать n-max на 1 больше (нужен запас VRAM).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job, position)(increase(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{job=~\"${model:regex}\"}[$__range])) / on(job) group_left sum by(job)(increase(llamacpp:spec_decode_num_drafts_total{job=~\"${model:regex}\"}[$__range]))",
          "legendFormat": "{{job}} · позиция {{position}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "orientation": "vertical",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
