      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "description": "Внутренняя оценка llama.cpp; для общей пропускной способности с параллельными запросами см. соседний график.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:predicted_tokens_seconds{job=~\"${model:regex}\"}",
